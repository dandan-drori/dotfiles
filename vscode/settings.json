{
  "github.copilot.selectedCompletionModel": "",
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.generateTests.codeLens": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.chat.executeImmediately": true,
  "github.copilot.chat.runCommands": "always",
  "github.copilot.chat.runCommand.enabled": true,
  "explorer.confirmDelete": false,
  "git.autofetch": true,
  "editor.minimap.enabled": false,
  "editor.fontFamily": "MesloLGS NF,monaspace",
  "editor.fontLigatures": true,
  "git.confirmSync": false,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "on",
  "workbench.iconTheme": "catppuccin-macchiato",
  "workbench.colorTheme": "Catppuccin Macchiato",
  "jest.runMode": "on-demand",
  "testing.automaticallyOpenTestResults": "neverOpen",
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "windsurf": true,
    "cursor-global": true,
    "cursor-workspace": true
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "explorer.confirmDragAndDrop": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.enableSmartCommit": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontSize": 16,
  "window.openFoldersInNewWindow": "on",
  "prettier.singleQuote": true,
  "workbench.settings.applyToAllProfiles": ["prettier.singleQuote"],
  "debug.enableStatusBarColor": false,
  "extensions.ignoreRecommendations": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "cSpell.userWords": [
    "Agentic",
    "CHECKMARK",
    "Pixelify",
    "theunderscorer",
    "uuidv",
  ],
  "playwright.reuseBrowser": true,
  "terminal.integrated.scrollback": 10000,
  "liveServer.settings.donotShowInfoMsg": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "update.showReleaseNotes": false,
  "chat.tools.terminal.outputLocation": "chat",
  "explorer.confirmPasteNative": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "chat.disableAIFeatures": true,
}
